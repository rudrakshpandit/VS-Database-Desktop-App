{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VS Database Host",
  "version": "2.2.2",
  "identifier": "com.vsdatabase.host",
  "app": {
    "windows": [
      {
        "title": "VS Database Host",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#eef2ff",
        "shadow": true,
        "center": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/server_sidecar"
    ]
  }
}
